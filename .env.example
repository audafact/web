VITE_APP_ENV=development
VITE_AUDIO_SAMPLE_RATE=44100
VITE_MAX_UPLOAD_SIZE=25000000
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# OAuth/email callback must match Supabase Auth > URL config EXACTLY (scheme + host + port + path).
# Default dev (HTTP): http://localhost:5173/auth/callback
# If you use Vite TLS (certs/dev-key.pem), use https and add the SAME URL in Supabase:
# VITE_AUTH_REDIRECT_URL=https://localhost:5173/auth/callback
#
# If OAuth skips localhost entirely (you land on production): Supabase falls back to "Site URL"
# when redirect_to is not accepted. Set Site URL to your dev origin (e.g. https://localhost:5173)
# while working locally, and add that callback under Redirect URLs (exact match or wildcard if enabled).
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# Phone/LAN dev: set to the LAN IP or hostname your phone uses so Vite HMR WebSocket connects (e.g. 192.168.1.66).
# VITE_DEV_HMR_HOST=192.168.1.66
VITE_SUPABASE_DB_PASS=your_supabase_db_password
VITE_SUPABASE_DB_USER=your_supabase_db_user
VITE_SUPABASE_DB_HOST=your_supabase_db_host
VITE_SUPABASE_DB_PORT=your_supabase_db_port
VITE_SUPABASE_DB_NAME=your_supabase_db_name
VITE_SUPABASE_DB_SSL=your_supabase_db_ssl
VITE_SUPABASE_DB_SSL_MODE=your_supabase_db_ssl_mode 